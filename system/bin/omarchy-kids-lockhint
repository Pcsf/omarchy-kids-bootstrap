#!/usr/bin/env bash
# omarchy-kids-lockhint -- tell logind when the child's screen is locked, so
# Timekpr stops counting screen time while hyprlock is up.
#
# GNOME and KDE set the session's IdleHint/LockedHint when they lock; Hyprland
# does not, so Timekpr saw a locked screen as an active session. This runs as
# a systemd user service in the child's graphical session, asks the compositor
# whether the session is locked and sets both hints on the child's display
# session. Timekpr is configured with --settrackinactive false, so an
# idle/locked session is not counted.
#
# Omarchy 4 draws its lock screen inside its quickshell shell (no hyprlock
# process); omarchy-hyprland-session-locked reads the lock state from
# Hyprland itself (exit 0 = locked). The compositor's answer cannot be faked
# by a renamed process. A real /usr/bin/hyprlock also counts, for setups
# that still use it.
set -u

LOCKER=/usr/bin/hyprlock
INTERVAL="${OMARCHY_KIDS_LOCKHINT_INTERVAL:-5}"

# The service may start before uwsm exports the Hyprland instance; find it.
hypr_env() {
    local run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" dir best=""
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -S "$run/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock" ]; then
        return 0
    fi
    # Newest live Hyprland instance (pure bash: no ls, which may be aliased).
    for dir in "$run"/hypr/*/; do
        [ -S "$dir.socket.sock" ] || continue
        if [ -z "$best" ] || [ "$dir" -nt "$best" ]; then best="$dir"; fi
    done
    [ -n "$best" ] || return 1
    best="${best%/}"
    export HYPRLAND_INSTANCE_SIGNATURE="${best##*/}"
}

is_locked() {
    local pid
    if command -v omarchy-hyprland-session-locked >/dev/null 2>&1 && hypr_env; then
        omarchy-hyprland-session-locked >/dev/null 2>&1 && return 0
    fi
    for pid in $(pgrep -u "$(id -u)" -x hyprlock 2>/dev/null); do
        [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$LOCKER" ] && return 0
    done
    return 1
}

# The child's graphical session: logind's Display session if set, otherwise
# the user's wayland/x11 session, otherwise any session on a seat.
session_id() {
    local me sid type seat fallback=""
    me="$(id -un)"
    sid="$(loginctl show-user "$me" -p Display --value 2>/dev/null)"
    if [ -n "$sid" ]; then printf '%s\n' "$sid"; return 0; fi
    for sid in $(loginctl show-user "$me" -p Sessions --value 2>/dev/null); do
        type="$(loginctl show-session "$sid" -p Type --value 2>/dev/null)"
        seat="$(loginctl show-session "$sid" -p Seat --value 2>/dev/null)"
        case "$type" in wayland|x11) printf '%s\n' "$sid"; return 0 ;; esac
        [ -z "$fallback" ] && [ -n "$seat" ] && fallback="$sid"
    done
    [ -n "$fallback" ] && printf '%s\n' "$fallback"
}

session_path() {
    local sid
    sid="$(session_id)"
    [ -n "$sid" ] || return 1
    busctl call org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager GetSession s "$sid" 2>/dev/null | awk '{gsub(/"/, "", $2); print $2}'
}

set_hints() {
    local path="$1" value="$2"
    busctl call org.freedesktop.login1 "$path" org.freedesktop.login1.Session SetIdleHint b "$value" &&
        busctl call org.freedesktop.login1 "$path" org.freedesktop.login1.Session SetLockedHint b "$value"
}

state=""
while :; do
    if is_locked; then want=true; else want=false; fi
    if [ "$want" != "$state" ]; then
        if path="$(session_path)" && [ -n "$path" ] && set_hints "$path" "$want"; then
            state="$want"
        fi
    fi
    sleep "$INTERVAL"
done
